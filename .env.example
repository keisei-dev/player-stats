# Hosted Postgres (Supabase transaction pooler, or a Neon "-pooler" host).
# When set, this is used instead of the PG* variables below. SSL is on for
# non-local hosts. Use the pooled string in the deployed app.
DATABASE_URL=

# Direct connection used only by `npm run db:seed` (Supabase port 5432, or
# Neon's host without "-pooler"). COPY often fails on a transaction pooler.
# If this is empty, the seed uses DATABASE_URL.
DIRECT_URL=

# Optional TLS overrides for DATABASE_URL / DIRECT_URL.
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Local Postgres, used when DATABASE_URL is empty.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=worldcup

# Pool size. Defaults to 1 for DATABASE_URL (the hosted pooler multiplexes)
# and 10 for a local database.
# PG_POOL_MAX=1

# Express server port (local dev)
PORT=3000

# Public base URL of the API, consumed by the Astro dev server.
# Leave this unset on Vercel so the UI calls /api on the same host.
PUBLIC_API_BASE_URL=http://localhost:3000
